            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents?near=1.2150,-77.2800&radius=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents?near=1.2150,-77.2800&radius=3"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Ver reporte",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
