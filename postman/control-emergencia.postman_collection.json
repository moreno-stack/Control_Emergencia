              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Olga Operadora\",\n  \"email\": \"olga@example.com\",\n  \"password\": \"operadora-segura-123\",\n  \"role\": \"operator\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
