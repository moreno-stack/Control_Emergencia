    {
      "name": "3. Reportes (Incidents)",
      "item": [
        {
          "name": "Crear reporte",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Incendio en bodega\",\n  \"category\": \"fire\",\n  \"description\": \"Sale humo negro de una bodega del barrio.\",\n  \"address\": \"Calle 18 # 25-30, Pasto\",\n  \"latitude\": 1.2142,\n  \"longitude\": -77.2811\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.incident && json.incident.id) pm.collectionVariables.set('incidentId', json.incident && json.incident.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar reportes (paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents?page=1&limit=20"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por texto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
